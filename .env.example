# Copy to .env and fill in. `PUBLIC_`-prefixed values are compiled into the browser bundle;
# everything else stays server-side in Pages Functions. Production values live in the Cloudflare
# Pages dashboard (Settings → Variables and Secrets), NOT in a wrangler.toml — adding one to this
# repo would make the file the source of truth and lock the dashboard values to read-only.

# Cloudflare Turnstile — contact form, comments, newsletter subscribe
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Contact form → n8n. The JWT secret also salts comment ip_hash and signs newsletter opt-in tokens.
JWT_SIGNING_SECRET=
N8N_WEBHOOK_URL=

# Umami analytics (production builds only)
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Access, guarding /admin. Both come from the Access application, so create it first:
#   Zero Trust > Access controls > Applications > Configure > Additional settings
#     ACCESS_AUD          = "Application Audience (AUD) Tag" (64-char hex)
#     ACCESS_TEAM_DOMAIN  = yourteam.cloudflareaccess.com
# The team domain is also just the hostname Access redirects you to when you hit /admin logged out.
# Scheme and trailing slash are stripped if you paste the full URL.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Resend — newsletter double opt-in and new-comment notifications.
# RESEND_SEGMENT_ID: Resend renamed Audiences to Segments; this is that list's id.
# NEWSLETTER_FROM: a verified sender on makingcode.io, e.g. `MakingCode <posts@makingcode.io>`.
# COMMENT_NOTIFY_TO: where new-comment pings go. Leave blank to disable them.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
NEWSLETTER_FROM=
COMMENT_NOTIFY_TO=

# Local development only — skips Access verification on /admin, and only when the request host is
# also localhost. Never set this in the Cloudflare Pages dashboard.
# ADMIN_DEV_BYPASS=true

# The comments database is a Cloudflare D1 binding named DB, not a URL. It is bound through the
# Pages dashboard in production and passed as a --d1 flag locally (see the pages:dev script).
