---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/logo.png' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const isProd = import.meta.env.PROD;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Fonts: Fraunces (display) + IBM Plex Sans (body) + IBM Plex Mono (labels/meta) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
/>
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<title>{title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />

<!--
  Turnstile loader, centralized here rather than emitted per form: blog posts now render two widgets
  (newsletter + comments) and duplicate api.js tags would fetch and initialize the script twice.
  Injected only when the page actually contains a widget, so the home page, listings, and About don't
  pull in a third-party script they have no use for.
-->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (!document.querySelector('.cf-turnstile')) return;
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  });
</script>

<!-- Umami Analytics (production only) -->
{isProd && umamiUrl && umamiWebsiteId && (
  <script
    defer
    src={umamiUrl}
    data-website-id={umamiWebsiteId}
  />
)}
