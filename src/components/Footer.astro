---
import { SITE_TITLE, CONTACT_PATH } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-border) bg-(--color-surface)">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-1">
      <span class="font-display text-base font-semibold text-(--color-ink)">{SITE_TITLE}</span>
      <p class="max-w-xs text-sm text-(--color-ink-muted)">Making Code One Example At A Time.</p>
    </div>

    <div class="label-mono flex gap-6 text-xs text-(--color-ink-muted)">
      <a href={CONTACT_PATH} class="hover:text-(--color-accent)">Contact</a>
      <a href="https://github.com" class="hover:text-(--color-accent)">GitHub</a>
      <a href="https://linkedin.com" class="hover:text-(--color-accent)">LinkedIn</a>
    </div>
  </div>
  <div class="border-t border-(--color-border)">
    <div class="label-mono mx-auto max-w-6xl px-6 py-4 text-[11px] text-(--color-ink-muted)">
      &copy; {year} MakingCode &mdash; Est. structural integrity in every deploy.
    </div>
  </div>
</footer>
