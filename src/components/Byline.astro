---
import { YEARS_IN_ENTERPRISE_SOFTWARE } from '../consts';
---

<div
  class="mt-16 flex flex-col gap-3 border-t border-(--color-border) pt-8 sm:flex-row sm:items-start sm:gap-5"
>
  <div
    class="label-mono flex h-12 w-12 shrink-0 items-center justify-center border border-(--color-border-strong) text-sm font-semibold text-(--color-ink)"
    aria-hidden="true"
  >
    JD
  </div>
  <div class="flex flex-col gap-1">
    <p class="font-display text-base font-semibold text-(--color-ink)">John DeLeon</p>
    <p class="text-sm text-(--color-ink-muted)">
      {YEARS_IN_ENTERPRISE_SOFTWARE} years in enterprise software, now writing through the transition into AI and automation.{' '}
      <a href="/about/" class="text-(--color-accent) underline underline-offset-4">More about me</a>.
    </p>
  </div>
</div>
