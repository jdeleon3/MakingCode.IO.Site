---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { isPublished, byNewestFirst } from '../../lib/publishing';

const posts = (await getCollection('blog', isPublished)).sort(byNewestFirst);
---

<BaseLayout
  title="Blog"
  description="Field notes from the transition into AI and automation — what worked, what didn't, and what I still don't know."
>
  <section class="mx-auto max-w-6xl px-6 py-24">
    <span class="label-mono text-xs text-(--color-accent)">Field Notes</span>
    <h1 class="font-display mb-12 mt-3 text-4xl font-semibold text-(--color-ink)">Blog</h1>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <Card
            href={`/blog/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
