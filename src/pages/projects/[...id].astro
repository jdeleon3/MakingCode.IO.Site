---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const ogImage = project.data.heroImage
  ? (await getImage({ src: project.data.heroImage, width: 1200, height: 630 })).src
  : undefined;
---

<ProjectLayout
  title={project.data.title}
  description={project.data.description}
  pubDate={project.data.pubDate}
  updatedDate={project.data.updatedDate}
  tags={project.data.tags}
  domain={project.data.domain}
  techStack={project.data.techStack}
  impact={project.data.impact}
  heroImage={project.data.heroImage}
  ogImage={ogImage}
>
  <Content />
</ProjectLayout>
