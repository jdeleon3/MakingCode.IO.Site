---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="sticky top-0 z-10 bg-white shadow-md">
	<nav class="mb-8 min-h-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-center h-20">
				<div class="flex items-center pb-4">
					<a href="/">
						<img src="/SVG_3_resized100.png" alt="Making Code" class="max-h-20 pt-4"/></a>
				</div>

				<!-- <div class="hidden md:flex items-center flex-1 justify-center px-4">
					<input type="text" placeholder="Search..." class="w-full max-w-xs px-3 py-1.5 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-primary text-sm"/>
				</div> -->


				<div class="hidden md:flex space-x-8 items-center">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/blog">Blog</HeaderLink>
					<HeaderLink href="/projects">Projects</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
				</div>

				<!--Mobile Menu -->
				<div class="md:hidden flex items-center">
					<button
						class="md:hidden text-gray-600 dark:text-gray-200 focus:outline-none">
						<svg
							id="menu-icon"
							class="w-6 h-6"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
						>
							<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M4 6h16M4 12h16M4 18h16"
							/>
						</svg>
						<svg
							id="close-icon"
							class="w-6 h-6 hidden"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							viewBox="0 0 24 24"
						>
							<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M6 18L18 6M6 6l12 12"
							/>
						</svg>
						</button>
				</div>
			</div>
		</div>
	</nav>
	<div id="mobile-menu" class="hidden md:hidden bg-white shadow-md p-4 flex flex-col items-center">
		<!--<div class="md:hidden justify-center px-4">
					<input type="text" placeholder="Search..." class="w-full max-w-xs px-3 py-1.5 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-primary text-sm"/>
				</div>
				<hr class="w-full border-gray-300 my-2" /> -->
        <!--Mobile Menu-->
        <ul class="md:hidden width-full text-center text-xl font-semibold mt-4">
          
            <li><HeaderLink href="/">Home</HeaderLink></li>
							<li><HeaderLink href="/blog">Blog</HeaderLink></li>
							<li><HeaderLink href="/projects">Projects</HeaderLink></li>
							<li><HeaderLink href="/about">About</HeaderLink></li>
          
        </ul>
      </div>
</header>
<script type="text/javascript">
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');
	const mobileMenu = document.getElementById('mobile-menu');

	menuIcon.addEventListener('click', () => {
		mobileMenu.classList.toggle('hidden');
		menuIcon.classList.toggle('hidden');
		closeIcon.classList.toggle('hidden');
	});

	closeIcon.addEventListener('click', () => {
		mobileMenu.classList.toggle('hidden');
		menuIcon.classList.toggle('hidden');
		closeIcon.classList.toggle('hidden');
	});
</script>