{
  "name": "makingcode-io-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc --noEmit -p functions/tsconfig.json && astro build",
    "preview": "astro preview",
    "pages:dev": "astro build && wrangler pages dev dist --env-file .env --compatibility-date=2026-07-07",
    "check": "astro check",
    "sync": "astro sync"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.108.0"
  }
}
